    "surface-white": { "alias": "surface-field", "deprecated": "use --surface-field" }
  },
  "semantic": {
    "brand-deep": { "alias": "harvest-green", "figma": "brand/deep" },
    "brand-highlight": { "alias": "seedling-green", "figma": "brand/highlight" },
    "brand-sunlit": { "alias": "sunlit-fields", "figma": "brand/sunlit" },
    "brand-glow": { "alias": "harvest-glow", "figma": "brand/glow" },
