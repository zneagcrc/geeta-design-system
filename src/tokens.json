    "blue-dark": { "value": "#21398b", "figma": "Blue dark", "role": "Information text" }
  },
  "neutral": {
    "neutral-dark": { "value": "#333333", "figma": "Neutral dark", "role": "Body text, labels" },
    "neutral-mid": { "value": "#666666", "figma": "Neutral mid", "role": "Secondary text, field and icon button borders" },
    "neutral-mid-light": { "value": "#999999", "figma": "Neutral mid-light", "role": "Section rules, object list rows" },
    "neutral-light": { "value": "#dddddd", "figma": "Neutral light", "role": "Read-only field background" },
