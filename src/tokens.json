{
  "$description": "Design tokens for every geeta tool. Colours are the Figma colour variables (same names); the rest are the values documented on the Figma Foundations page. Edit here, then run `npm run build`.",
  "color": {
    "harvest-green": { "value": "#164030", "figma": "Harvest green", "role": "Brand, deep green" },
    "paddock-green": { "value": "#0c5c3e", "figma": "Paddock green", "role": "Controls, selected state, panel titles" },
    "pasture-green": { "value": "#058c48", "figma": "Pasture green", "role": "Success outline, icons" },
    "seedling-green": { "value": "#87c05e", "figma": "Seedling green", "role": "Brand, logo canopy" },
    "fleece-white": { "value": "#f3f3f2", "figma": "Fleece white", "role": "Panel, neutral surface" },
    "earth-red": { "value": "#a33019", "figma": "Earth red", "role": "Error, message text" },
    "golden": { "value": "#e07c29", "figma": "Golden", "role": "Alert outline" },
    "sunlit-fields": { "value": "#fbb925", "figma": "Sunlit fields", "role": "Supporting brand colour" },
    "harvest-glow": { "value": "#fbd476", "figma": "Harvest glow", "role": "Supporting brand colour" },
    "yellow-light": { "value": "#fcf0d1", "figma": "Yellow light", "role": "Alert background" },
    "red-light": { "value": "#fbeae7", "figma": "Red light", "role": "Error background" },
    "green-light": { "value": "#e6f8d8", "figma": "Green light", "role": "Success background" },
    "blue-light": { "value": "#d9ddf4", "figma": "Blue light", "role": "Information background" },
    "blue-mid": { "value": "#4861b2", "figma": "Blue mid", "role": "Information outline" },
    "blue-dark": { "value": "#21398b", "figma": "Blue dark", "role": "Information text" }
  },
  "neutral": {
    "text-strong": { "value": "#333333", "role": "Body text, labels" },
    "text-muted": { "value": "#666666", "role": "Secondary text, data values" },
    "border-field": { "value": "#666666", "role": "Field border" },
    "border-rule": { "value": "#999999", "role": "Section rules under subheaders" },
    "border-divider": { "value": "#cccccc", "role": "Dividers" },
    "surface-white": { "value": "#ffffff", "role": "Fields, panel headers, top bar" },
    "hover-tint": { "value": "#e6e9e5", "role": "Hover background on Fleece white controls" }
  },
  "font": {
    "display": { "value": "'JUST Sans', Arial, sans-serif", "role": "Titles, headings, controls" },
    "body": { "value": "Arial, Helvetica, sans-serif", "role": "Data, labels, supporting text" }
  },
  "font-size": {
    "brand": { "value": "24px", "role": "Brand heading (JUST Sans)" },
    "panel-title": { "value": "22px", "role": "Panel title (JUST Sans)" },
    "section": { "value": "16px", "role": "Section heading / subheader (JUST Sans)" },
    "control": { "value": "14px", "role": "Control label (JUST Sans)" },
    "data": { "value": "14px", "role": "Data label and value (Arial)" },
    "small": { "value": "12px", "role": "Supporting text (Arial)" },
    "fine": { "value": "11px", "role": "Small print, e.g. data sources (Arial)" }
  },
  "space": {
    "4": { "value": "4px", "role": "Icon gap" },
    "8": { "value": "8px", "role": "Row gap, message inset" },
    "10": { "value": "10px", "role": "Internal gap" },
    "12": { "value": "12px", "role": "Menu gap, field inset" },
    "16": { "value": "16px", "role": "Panel gutter" },
    "32": { "value": "32px", "role": "Panel base inset" }
  },
  "radius": {
    "small": { "value": "4px", "role": "Messages, button groups" },
    "field": { "value": "6px", "role": "Fields" },
    "panel": { "value": "8px", "role": "Panels" }
  },
  "shadow": {
    "panel": { "value": "0 2px 4px rgba(0, 0, 0, 0.25), 0 2px 3px rgba(0, 0, 0, 0.5)", "role": "Floating panels" }
  }
}
